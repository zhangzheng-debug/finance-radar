# Copy this file to .env. Never commit the real .env file.

# SEC requires an identifiable User-Agent with a real contact email.
# Example: FinanceRadar your-name@example.com
SEC_USER_AGENT=

# Optional for the BLS probe. Without it, the unregistered public API is tested.
BLS_API_KEY=

# Free registrations / account credentials required by these providers.
BEA_API_KEY=
MARKETAUX_API_TOKEN=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FRED_API_KEY=
TWELVE_DATA_API_KEY=

# Crypto event observations use Binance's public market-data-only host directly
# and require no API key. The SSH relay below is an optional Gate-0 diagnostic,
# not the persistent Worker path and never reads a remote trading project.

# Local IBKR TWS paper-account market data. Keep TWS "Read-Only API" enabled.
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7497
IBKR_CLIENT_ID=71

# Optional read-only Binance public-market relay. This never uses Binance
# account credentials and never calls account/order endpoints.
BINANCE_REMOTE_SSH_HOST=
BINANCE_REMOTE_SSH_PORT=22
BINANCE_REMOTE_SSH_USER=
BINANCE_REMOTE_SSH_KEY=

# Read-only probes use getMe and getChat. They never send a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Personal-account MTProto source collector. This side is read-only and is
# separate from the Bot API output channel above.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram/finance_radar_user
TELEGRAM_DB=data/finance_radar.sqlite3
TELEGRAM_CHANNELS_CONFIG=config/telegram_channels.json

# Product application / VPS deployment
FINANCE_RADAR_RELEASE_ID=local
FINANCE_RADAR_GIT_COMMIT=unknown
FINANCE_RADAR_DB=data/finance_radar.sqlite3
FINANCE_RADAR_OPS_DB=data/finance_radar_operations.sqlite3
FINANCE_RADAR_ARTIFACT_DIR=artifacts
FINANCE_RADAR_REPLAY_DIR=replay/cases
FINANCE_RADAR_API_URL=http://127.0.0.1:8000
FINANCE_RADAR_WEB_URL=http://127.0.0.1:8501
FINANCE_RADAR_PUBLIC_URL=http://localhost
FINANCE_RADAR_DOMAIN=localhost
FINANCE_RADAR_DEMO_MODE=RECENT_CAPTURE
# Public UI processes must set this to public and must not receive the token
# below. The systemd deployment creates /etc/finance-radar-public.env with only
# the loopback API URL, this role, and debug disabled.
FINANCE_RADAR_UI_ROLE=public
# Internal loopback UIs use separate least-privilege tokens. The admin token
# remains a break-glass superset. Never place any of them in the public Web
# environment or expose them to browser code.
FINANCE_RADAR_ADMIN_TOKEN=replace-with-a-long-random-value
FINANCE_RADAR_REVIEWER_TOKEN=replace-with-a-different-long-random-value
# Human blind-review submissions require a unique credential per person. This
# JSON is for local/Compose only. Production systemd reads the same array from
# /etc/finance-radar-reviewer-principals.json via LoadCredential instead.
# Example roles: two REVIEWER principals and one independent ARBITER principal.
FINANCE_RADAR_REVIEWER_PRINCIPALS_JSON=[]
FINANCE_RADAR_OPERATOR_TOKEN=replace-with-another-long-random-value
FINANCE_RADAR_API_RATE_LIMIT_PER_MINUTE=180
FINANCE_RADAR_API_RATE_LIMIT_MAX_CLIENTS=4096
# Only direct socket peers listed here may provide a validated X-Real-IP.
FINANCE_RADAR_API_TRUSTED_PROXY_HOSTS=127.0.0.1,::1
FINANCE_RADAR_WORKER_INTERVAL=300
FINANCE_RADAR_BACKUP_INTERVAL=86400
# Keep one latest verified daily recovery bundle.  Older bundles are pruned
# only after the new ledger+operations+evidence/report manifest restores cleanly.
FINANCE_RADAR_BACKUP_RETENTION=1
FINANCE_RADAR_WEEKLY_BACKUP_RETENTION=0

# Optional local Evidence Agent shadow reviewer. Only HTTP loopback URLs are
# accepted. Its output is advisory and cannot change deterministic status gates.
FINANCE_RADAR_EVIDENCE_LLM_URL=
FINANCE_RADAR_EVIDENCE_LLM_MODEL=qwen2.5-0.5b-instruct-q4_k_m
FINANCE_RADAR_EVIDENCE_LLM_TIMEOUT_SECONDS=30
FINANCE_RADAR_EVIDENCE_LLM_MAX_TOKENS=900

# Optional external interpretation worker. Public requests never call this
# provider. Keep DEEPSEEK_API_KEY in an ignored local env file during
# development; production supplies it as a service-specific systemd credential.
FINANCE_RADAR_CAPTURE_LLM_ENABLED=0
FINANCE_RADAR_CAPTURE_LLM_PROVIDER=deepseek
FINANCE_RADAR_CAPTURE_LLM_MODEL=deepseek-v4-flash
FINANCE_RADAR_CAPTURE_LLM_BASE_URL=https://api.deepseek.com
FINANCE_RADAR_CAPTURE_LLM_TIMEOUT_SECONDS=45
FINANCE_RADAR_CAPTURE_LLM_MAX_TOKENS=700
# 0 means unlimited; usage is still metered and recorded.
FINANCE_RADAR_CAPTURE_LLM_DAILY_CNY_CAP=0
FINANCE_RADAR_CAPTURE_LLM_DAILY_REQUEST_CAP=0
