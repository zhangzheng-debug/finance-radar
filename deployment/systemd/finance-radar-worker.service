[Unit]
Description=Finance Radar continuous evidence worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
EnvironmentFile=/etc/finance-radar.env
ExecStart=/opt/finance-radar/venv/bin/python -m app.workers.continuous --interval 300
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finance-radar/shared/data /opt/finance-radar/shared/reports

[Install]
WantedBy=multi-user.target
