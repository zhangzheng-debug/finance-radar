[Unit]
Description=Finance Radar local Evidence Agent shadow model
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/finance-radar/evidence-llm/models/qwen2.5-0.5b-instruct-q4_k_m.gguf

[Service]
Type=simple
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/evidence-llm
Environment=LD_LIBRARY_PATH=/opt/finance-radar/evidence-llm/current
ExecStart=/opt/finance-radar/evidence-llm/current/llama-server --model /opt/finance-radar/evidence-llm/models/qwen2.5-0.5b-instruct-q4_k_m.gguf --alias qwen2.5-0.5b-instruct-q4_k_m --host 127.0.0.1 --port 18601 --ctx-size 2048 --threads 2 --threads-batch 2 --parallel 1 --batch-size 128 --ubatch-size 128
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/finance-radar/evidence-llm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=900M
MemoryMax=1100M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target
