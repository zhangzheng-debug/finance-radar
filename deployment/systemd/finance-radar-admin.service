[Unit]
Description=Finance Radar Internal Administration (manual, loopback only)
Documentation=file:/opt/finance-radar/current/deployment/README.md
After=network-online.target finance-radar-api.service
Wants=network-online.target
Requires=finance-radar-api.service

[Service]
Type=simple
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
EnvironmentFile=/etc/finance-radar.env
Environment=FINANCE_RADAR_UI_ROLE=admin
Environment=FINANCE_RADAR_SHOW_DEBUG=0
ExecStart=/opt/finance-radar/venv/bin/python -B -m streamlit run app/web/Admin.py --server.address 127.0.0.1 --server.port 18502 --server.baseUrlPath radar-admin --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
MemoryHigh=160M
MemoryMax=256M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finance-radar/shared/data /opt/finance-radar/shared/reports

# Intentionally no [Install] section: operators start this unit manually for a
# short-lived SSH-tunnel session. It cannot be enabled as a boot-time service.
