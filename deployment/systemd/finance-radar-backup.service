[Unit]
Description=Finance Radar single latest verified recovery bundle and restore drill
After=finance-radar-api.service

[Service]
Type=oneshot
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
EnvironmentFile=/etc/finance-radar.env
# Retention is intentionally one latest verified daily bundle.  The backup job
# only removes the previous bundle after the new ledger+operations+manifest
# restore verification succeeds.
ExecStart=/opt/finance-radar/venv/bin/python -m app.ops.backup backup --retention 1 --weekly-retention 0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finance-radar/shared/data
