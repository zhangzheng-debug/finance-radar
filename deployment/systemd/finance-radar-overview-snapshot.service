[Unit]
Description=Finance Radar external overview snapshot publisher
After=network-online.target
Before=finance-radar-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
Slice=finance-radar.slice
EnvironmentFile=/etc/finance-radar.env
Environment=FINANCE_RADAR_OVERVIEW_SNAPSHOT_PATH=/opt/finance-radar/shared/data/overview_snapshot_v1.json
ExecStart=/opt/finance-radar/venv/bin/python -B scripts/build_overview_snapshot.py --wait-for-worker-idle-seconds 600 --worker-idle-poll-seconds 5
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
CPUWeight=25
MemoryHigh=260M
MemoryMax=360M
MemorySwapMax=192M
TasksMax=64
MemoryAccounting=true
OOMPolicy=stop
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/opt/finance-radar/shared/data

[Install]
WantedBy=multi-user.target
