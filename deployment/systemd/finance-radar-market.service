[Unit]
Description=Finance Radar bounded market observation cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
Slice=finance-radar.slice
EnvironmentFile=/etc/finance-radar.env
RuntimeDirectory=finance-radar-market
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/finance-radar-market/market.lock /opt/finance-radar/venv/bin/python -B scripts/run_market_cycle.py --report /opt/finance-radar/shared/data/market_cycle_latest.json --timeout 30
TimeoutStartSec=3min
Nice=8
CPUWeight=35
MemoryHigh=180M
MemoryMax=280M
MemorySwapMax=128M
TasksMax=64
MemoryAccounting=true
OOMPolicy=stop
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/opt/finance-radar/shared/data

[Install]
WantedBy=multi-user.target
