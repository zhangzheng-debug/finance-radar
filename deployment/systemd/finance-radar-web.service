[Unit]
Description=Finance Radar Streamlit Situation Room
After=network-online.target finance-radar-api.service
Wants=network-online.target
Requires=finance-radar-api.service

[Service]
Type=simple
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
EnvironmentFile=/etc/finance-radar.env
ExecStart=/opt/finance-radar/venv/bin/python -m streamlit run app/web/Home.py --server.address 127.0.0.1 --server.port 18501 --server.baseUrlPath radar --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finance-radar/shared/data /opt/finance-radar/shared/reports

[Install]
WantedBy=multi-user.target
