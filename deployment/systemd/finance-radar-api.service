[Unit]
Description=Finance Radar FastAPI
After=network-online.target finance-radar-overview-snapshot.service
Wants=network-online.target

[Service]
Type=simple
User=finance-radar
Group=finance-radar
WorkingDirectory=/opt/finance-radar/current
Slice=finance-radar.slice
EnvironmentFile=/etc/finance-radar.env
Environment=FINANCE_RADAR_OVERVIEW_SNAPSHOT_PATH=/opt/finance-radar/shared/data/overview_snapshot_v1.json
LoadCredential=reviewer-principals.json:/etc/finance-radar-reviewer-principals.json
ExecStartPre=/usr/bin/test -s /opt/finance-radar/shared/data/overview_snapshot_v1.json
ExecStart=/opt/finance-radar/venv/bin/python -m uvicorn app.api.main:app --host 127.0.0.1 --port 18000 --workers 1
Restart=on-failure
RestartSec=5
# The API is small but long-lived. Keep its ceiling in the versioned unit so a
# rebuilt host does not depend on an opaque `systemctl set-property` drop-in.
MemoryHigh=320M
MemoryMax=430M
MemorySwapMax=128M
TasksMax=128
MemoryAccounting=true
OOMPolicy=stop
OOMScoreAdjust=-500
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finance-radar/shared/data /opt/finance-radar/shared/reports

[Install]
WantedBy=multi-user.target
