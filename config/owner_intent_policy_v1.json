  "hard_gates": [
    {
      "id": "FR-PROD-001",
      "rule": "The product remains a personal read-only financial-event evidence radar."
    },
    {
      "id": "FR-PROD-008",
      "rule": "Every canonical event remains publicly browseable; workflow, canonical status and citation readiness never become per-event publication gates."
    },
    {
      "id": "FR-SHORT-001",
      "rule": "The ledger and fact layer remain all-polarity; adverse specialization exists only in review routing."
    },
    {
      "id": "FR-SHORT-003",
      "rule": "The risk router may decide only RISK_REVIEW, NON_TARGET or ABSTAIN."
    },
    {
      "id": "FR-SHORT-004",
      "rule": "The model never emits direction, return, sizing, alert or execution permission."
    },
    {
      "id": "FR-EVT-005",
      "rule": "Future outcomes, aliases, labels and market results never backfill an earlier event view."
    },
    {
      "id": "FR-GRADE-005",
      "rule": "Price moves are discovery prompts, never evidence or labels."
    },
    {
      "id": "FR-SRC-002",
      "rule": "Source authority never supplies severity, legal meaning, equity outcome or target label."
    },
    {
      "id": "FR-EVD-001",
      "rule": "Formal conclusions remain bound to exact, addressable, versioned and hashed evidence."
    },
    {
      "id": "FR-EVD-004",
      "rule": "Evidence or event-version change invalidates stale agent decisions and overrides."
    },
    {
      "id": "FR-EVD-008",
      "rule": "Canonical, adjudication, Evidence Agent and risk-router gate states remain separate namespaces."
    },
    {
      "id": "FR-EVD-009",
      "rule": "Citation readiness is a deterministic formal-claim projection, not manual approval, canonical status or a Public visibility gate."
    },
    {
      "id": "FR-EVD-010",
      "rule": "Public evidence posture remains independent of risk assessment, severity, market outcomes and internal workflow progress."
    },
    {
      "id": "FR-REV-002",
      "rule": "Bulk rough review is never reported as bulk formal verification."
    },
    {
      "id": "FR-REV-006",
      "rule": "The continuous worker never carries evergreen light-verification authority."
    },
    {
      "id": "FR-REV-007",
      "rule": "Formal training truth requires two independent blind humans and arbitration on disagreement."
    },
    {
      "id": "FR-REV-013",
      "rule": "Dual-human labels train, evaluate, calibrate and audit the automated system; they never become a per-event publication queue."
    },
    {
      "id": "FR-MDL-001",
      "rule": "Non-primary-supported input abstains at the deterministic gate without invoking the semantic model."
    },
    {
      "id": "FR-MDL-002",
      "rule": "Model invocation, decision source, applicability and hashes remain auditable."
    },
    {
      "id": "FR-MDL-003",
      "rule": "Training excludes internal labels, source shortcuts, old outputs and post-event outcomes."
    },
    {
      "id": "FR-MDL-007",
      "rule": "Qualified shadow never means fact verification, alert permission or trading promotion."
    },
    {
      "id": "FR-MKT-004",
      "rule": "Missed market windows remain MISSED_WINDOW or UNAVAILABLE and are never backfilled."
    },
    {
      "id": "FR-ROLE-001",
      "rule": "Public, Reviewer, Operator and Admin remain separate capability surfaces."
    },
    {
      "id": "FR-ROLE-002",
      "rule": "Only Public is internet-facing; systemd uses host loopback and Compose uses a private container network."
    },
    {
      "id": "FR-NOTIFY-002",
      "rule": "Real external notification requires separate explicit authorization."
    },
    {
      "id": "FR-COST-002",
      "rule": "Cloud credits never justify expansion; optimize and stop unused resources first."
    },
    {
      "id": "FR-BAK-002",
      "rule": "The previous backup survives until the new backup passes full isolated restore verification."
    },
    {
      "id": "FR-BAK-006",
      "rule": "Production recovery assets stay in private storage and never in this public repository or its Releases."
    },
    {
      "id": "FR-LOCAL-002",
      "rule": "C-to-D movement records copy, validation, cutover and cleanup separately."
    },
    {
      "id": "FR-SEC-001",
      "rule": "No broker, order, cancellation, position, balance or execution capability is permitted."
    },
    {
      "id": "FR-SEC-003",
      "rule": "Secrets and plaintext production data never enter Git, reports, logs or Public UI."
    },
    {
      "id": "FR-REL-006",
      "rule": "Tests and CI are not deployment; a production claim requires cutover and live receipts."
    },
    {
      "id": "FR-STATE-001",
      "rule": "Current server claims require fresh live verification or an explicit historical-snapshot qualifier."
    }
  ]
