{
  "schema_version": 4,
  "architecture": "structured_evidence_gate_plus_binary_semantic_router_v1",
  "structured_input": [
    "evidence_state",
    "exact_evidence_text"
  ],
  "semantic_features": [
    "word TF-IDF 1-2 grams",
    "character TF-IDF 3-5 grams"
  ],
  "policy_gate": "semantic-policy-gate-v1",
  "outputs": [
    "RISK_REVIEW",
    "NON_TARGET",
    "ABSTAIN"
  ],
  "abstain_owner": "structured evidence gate",
  "prohibited": [
    "event status",
    "manual grade",
    "event taxonomy shortcut",
    "source identity shortcut",
    "post-event price",
    "return",
    "position",
    "order",
    "account data"
  ],
  "no_trading": true
}